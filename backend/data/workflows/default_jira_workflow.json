{
  "id": "newton-auto-etl-workflow",
  "name": "Newton · The AI Data Engineer Pipeline",
  "description": "End-to-end lifecycle — Jira / Teams / Slack through prod validation and sector skill learning",
  "phases": [
    {
      "id": "phase-intake",
      "name": "Intake",
      "tasks": [
        "Ticket received from Jira",
        "Teams / Slack notification relayed",
        "Context and attachments parsed"
      ]
    },
    {
      "id": "phase-triage",
      "name": "Triage",
      "tasks": [
        "Severity and type classified",
        "Domain / sector baseline loaded",
        "Priority and blast radius estimated"
      ]
    },
    {
      "id": "phase-investigation",
      "name": "Investigation",
      "tasks": [
        "Architecture memory searched",
        "Past incidents and skills matched",
        "Root cause identified"
      ]
    },
    {
      "id": "phase-planner",
      "name": "Planner",
      "tasks": [
        "Fix plan generated",
        "Impacted pipelines and tables listed",
        "Test and validation strategy defined"
      ]
    },
    {
      "id": "phase-coding",
      "name": "Coding",
      "tasks": [
        "Feature branch created",
        "ETL / ELT code changes generated",
        "Diffs prepared for review"
      ]
    },
    {
      "id": "phase-tests",
      "name": "Tests",
      "tasks": [
        "Unit tests executed",
        "Integration tests executed",
        "Data quality checks executed"
      ]
    },
    {
      "id": "phase-dev-deploy",
      "name": "Deploy to DEV",
      "tasks": [
        "Deployed to DEV",
        "DEV validation (row counts, schema, reconciliation)",
        "DEV results recorded"
      ]
    },
    {
      "id": "phase-pr",
      "name": "Pull Request",
      "tasks": [
        "PR created and linked to Jira",
        "PR review completed",
        "Human approval gate cleared"
      ]
    },
    {
      "id": "phase-prod",
      "name": "Production",
      "tasks": [
        "Merged to main",
        "Deployed to PROD",
        "PROD validation passed"
      ]
    },
    {
      "id": "phase-learn",
      "name": "Learn & Close",
      "tasks": [
        "Jira ticket updated automatically",
        "Organizational memory updated",
        "New sector skill learned from patterns"
      ]
    }
  ]
}
